<?xml version="1.0" encoding="utf-8"?>
<!-- HomeButton: sees when Google TV's home screen opens. It can't read what's on screen and it does not see key presses.
     (Remote-button shortcuts need two more attributes here: android:canRequestFilterKeyEvents="true" and
     android:accessibilityFlags="flagRequestFilterKeyEvents". They are left out of this public build; see HomeButton.java.) -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:packageNames="com.google.android.apps.tv.launcherx"
    android:notificationTimeout="0" />
